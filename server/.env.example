# Copy this file to .env and fill in your key. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here

# Groq retires models from time to time. If you get a "model not found /
# decommissioned" error, pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

PORT=5000
CLIENT_ORIGIN=http://localhost:5173
